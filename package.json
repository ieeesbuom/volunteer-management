{
  "name": "volunteer-management",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--disable-warning=DEP0205 FORCE_NODE_FETCH=1 next dev",
    "build": "cross-env NODE_OPTIONS=--disable-warning=DEP0205 FORCE_NODE_FETCH=1 next build",
    "start": "cross-env NODE_OPTIONS=--disable-warning=DEP0205 FORCE_NODE_FETCH=1 next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "cross-env NODE_OPTIONS=--disable-warning=DEP0205 vitest run",
    "check": "npm run lint && npm run typecheck",
    "setup:appwrite": "cross-env FORCE_NODE_FETCH=1 node scripts/setup-appwrite.mjs",
    "setup:appwrite:oauth": "cross-env FORCE_NODE_FETCH=1 node scripts/setup-appwrite-google-oauth.mjs",
    "appwrite:audit": "cross-env FORCE_NODE_FETCH=1 node scripts/appwrite/security-audit.mjs",
    "appwrite:harden": "cross-env FORCE_NODE_FETCH=1 node scripts/appwrite/harden-project.mjs",
    "appwrite:keys": "cross-env FORCE_NODE_FETCH=1 node scripts/appwrite/create-api-keys.mjs",
    "appwrite:keys:sync-env": "node scripts/appwrite/sync-env-keys.mjs",
    "appwrite:sessions:revoke-stale": "cross-env FORCE_NODE_FETCH=1 node scripts/appwrite/revoke-stale-sessions.mjs",
    "appwrite:migrate:uom": "cross-env FORCE_NODE_FETCH=1 node scripts/appwrite/migrate-uom-integrity.mjs",
    "appwrite:migrate:ledger": "cross-env FORCE_NODE_FETCH=1 node scripts/appwrite/migrate-point-ledger.mjs",
    "appwrite:backups": "cross-env FORCE_NODE_FETCH=1 node scripts/appwrite/configure-backups.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@types/pdfkit": "^0.17.6",
    "appwrite": "^25.2.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.3.0",
    "node-appwrite": "^25.2.0",
    "nodemailer": "^9.0.1",
    "pdfkit": "^0.18.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-grid-layout": "^2.2.4",
    "recharts": "^3.10.1",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-grid-layout": "^1.3.6",
    "appwrite-cli": "25.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
